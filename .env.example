# Congress.gov API key (free, 5,000 requests/hour). Request one at
# https://api.congress.gov/sign-up/ ; read in config/runtime.exs.
CONGRESS_GOV_API_KEY=

# Sentry error reporting (project thefloorvote/the-floor). Optional; nothing is
# sent without it. Read in config/runtime.exs (prod only); a Fly secret in prod.
SENTRY_DSN=

# Resend API key (sending access, domain everydaycitizen.vote) for sign-in links
# and the daily email. Required in production; read in config/runtime.exs. Dev
# and test use the local mailbox (/dev/mailbox) and need none.
RESEND_API_KEY=

# Anthropic API key for plain-English section summaries (development, and
# production until Workload Identity Federation is configured). Optional:
# without it summaries are off. Read in config/runtime.exs.
ANTHROPIC_API_KEY=
