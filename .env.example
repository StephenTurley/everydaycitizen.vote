# Congress.gov API key (free, 5,000 requests/hour). Request one at
# https://api.congress.gov/sign-up/ ; read in config/runtime.exs.
CONGRESS_GOV_API_KEY=

# Sentry error reporting (project thefloorvote/the-floor). Optional; nothing is
# sent without it. Read in config/runtime.exs (prod only); a Fly secret in prod.
SENTRY_DSN=
